# BUTTONS
# ============================================================


async def buttons(update: Update, context: ContextTypes.DEFAULT_TYPE):

    query = update.callback_query

    await query.answer()

    if query.data == "RATE":

        await query.message.reply_text(
            f"💱 Current Rate\n\n"
            f"1 USDT = ₹{RATE}"
        )

        return ConversationHandler.END

    if query.data == "ORDERS":

        await query.message.reply_text(
            "📋 Order history feature is available through /orders."
        )

        return ConversationHandler.END

    if query.data == "BUY":

        context.user_data.clear()

        context.user_data["action"] = "BUY"

        await query.message.reply_text(
            "💰 BUY USDT\n\n"
            "Enter how many USDT you want to buy.\n\n"
            "Example:\n"
            "100"
        )

        return 1

    if query.data == "SELL":

        context.user_data.clear()

        context.user_data["action"] = "SELL"

        await query.message.reply_text(
            "💵 SELL USDT\n\n"
            "Enter how many USDT you want to sell.\n\n"
            "Example:\n"
            "100"
        )

        return 1

    return ConversationHandler.END


# ============================================================
# AMOUNT
# ============================================================


async def amount(update: Update, context: ContextTypes.DEFAULT_TYPE):

    try:

        value = Decimal(
            update.message.text.strip()
        )

    except InvalidOperation:

        await update.message.reply_text(
            "❌ Invalid amount.\n\n"
            "Enter a number like:\n"
            "10\n"
            "50\n"
            "100.50"
        )

        return 1

    if value <= 0:

        await update.message.reply_text(
            "❌ Amount must be greater than 0."
        )

        return 1

    if value < Decimal("1"):

        await update.message.reply_text(
            "❌ Minimum amount is 1 USDT."
        )

        return 1

    inr = value * RATE

    context.user_data["usdt"] = value
    context.user_data["inr"] = inr

    if context.user_data["action"] == "BUY":

        await update.message.reply_text(
            f"💰 BUY USDT\n\n"
            f"USDT: {value}\n"
            f"Rate: ₹{RATE}\n"
            f"Total: ₹{inr:,.2f}\n\n"
            "Send your payment information."
        )

        return 2

    else:

        await update.message.reply_text(
            f"💵 SELL USDT\n\n"
            f"USDT: {value}\n"
            f"Rate: ₹{RATE}\n"
            f"You receive: ₹{inr:,.2f}\n\n"
            "Send your USDT wallet address."
        )

        return 3


