async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query

    await query.answer()

    data = query.data

    # --------------------------------------------------------
    # BUY
    # --------------------------------------------------------

    if data == "BUY":

        context.user_data.clear()

        context.user_data["action"] = "BUY"

        await query.message.reply_text(
            "💰 Buy USDT\n\n"
            "Enter the amount of USDT you want to buy.\n\n"
            "Example:\n"
            "100\n\n"
            "Minimum: 1 USDT"
        )

        return ENTER_AMOUNT

    # --------------------------------------------------------
    # SELL
    # --------------------------------------------------------

    if data == "SELL":

        context.user_data.clear()

        context.user_data["action"] = "SELL"

        await query.message.reply_text(
            "💵 Sell USDT\n\n"
            "Enter the amount of USDT you want to sell.\n\n"
            "Example:\n"
            "100\n\n"
            "Minimum: 1 USDT"
        )

        return ENTER_AMOUNT

    # --------------------------------------------------------
    # RATE
    # --------------------------------------------------------

    if data == "RATE":

        await query.message.reply_text(
            f"💱 Current Rate\n\n"
            f"1 USDT = {format_money(RATE)}"
        )

        return ConversationHandler.END

    # --------------------------------------------------------
    # ORDERS
    # --------------------------------------------------------

    if data == "ORDERS":

        user = update.effective_user

        orders = get_user_orders(user.id)

        if not orders:
            await query.message.reply_text(
                "📋 You don't have any orders yet."
            )

            return ConversationHandler.END

        text = "📋 Your Recent Orders\n\n"

        for order in orders:

            text += (
                f"🆔 Order #{order['id']}\n"
                f"Type: {order['action']}\n"
                f"USDT: {order['usdt_amount']}\n"
                f"INR: {format_money(order['inr_amount'])}\n"
                f"Status: {order['status']}\n"
                f"Date: {order['created_at'][:19]}\n"
                "--------------------\n"
            )

        await query.message.reply_text(text)

        return ConversationHandler.END

    # --------------------------------------------------------
    # ADMIN APPROVE
    # --------------------------------------------------------

    if data.startswith("APPROVE_"):

        if not is_admin(query.from_user.id):

            await query.message.reply_text(
                "❌ You are not authorized."
            )

            return ConversationHandler.END

        order_id = int(data.split("_")[1])

        order = get_order(order_id)

        if not order:

            await query.message.reply_text(
                "❌ Order not found."
            )

            return ConversationHandler.END

        update_order_status(order_id, "APPROVED")

        await query.message.edit_reply_markup(
            reply_markup=None
        )

        await query.message.reply_text(
            f"✅ Order #{order_id} approved."
        )

        try:
            await context.bot.send_message(
                chat_id=order["telegram_id"],
                text=(
                    f"✅ Your order #{order_id} has been approved.\n\n"
                    f"Type: {order['action']}\n"
                    f"USDT: {order['usdt_amount']}\n"
                    f"INR: {format_money(order['inr_amount'])}\n\n"
                    "Please follow the payment instructions provided by the administrator."
                ),
            )
        except Exception as e:
            logger.error(e)

        return ConversationHandler.END

    # --------------------------------------------------------
    # ADMIN REJECT
    # --------------------------------------------------------

    if data.startswith("REJECT_"):

        if not is_admin(query.from_user.id):

            await query.message.reply_text(
                "❌ You are not authorized."
            )

            return ConversationHandler.END

        order_id = int(data.split("_")[1])

        order = get_order(order_id)

        if not order:

            await query.message.reply_text(
                "❌ Order not found."
            )

            return ConversationHandler.END

        update_order_status(order_id, "REJECTED")

        await query.message.edit_reply_markup(
            reply_markup=None
        )

        await query.message.reply_text(
            f"❌ Order #{order_id} rejected."
        )

        try:
            await context.bot.send_message(
                chat_id=order["telegram_id"],
                text=(
                    f"❌ Your order #{order_id} has been rejected.\n\n"
                    "Please contact the administrator for more information."
                ),
            )
        except Exception as e:
            logger.error(e)

        return ConversationHandler.END

    return ConversationHandler.END


