async def amount_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):

    text = update.message.text.strip()

    try:
        amount = Decimal(text)
    except InvalidOperation:

        await update.message.reply_text(
            "❌ Invalid amount.\n\n"
            "Please enter a number like:\n"
            "10\n"
            "50\n"
            "100.50"
        )

        return ENTER_AMOUNT

    if amount <= 0:

        await update.message.reply_text(
            "❌ Amount must be greater than 0."
        )

        return ENTER_AMOUNT

    if amount < Decimal("1"):

        await update.message.reply_text(
            "❌ Minimum amount is 1 USDT."
        )

        return ENTER_AMOUNT

    inr_amount = amount * RATE

    context.user_data["usdt_amount"] = amount
    context.user_data["inr_amount"] = inr_amount

    action = context.user_data["action"]

    if action == "BUY":

        await update.message.reply_text(
            f"💰 Buy USDT\n\n"
            f"USDT Amount: {amount} USDT\n"
            f"Rate: ₹{RATE}\n"
            f"Total INR: {format_money(inr_amount)}\n\n"
            "Now enter your payment information.\n\n"
            "For example:\n"
            "UPI ID / Bank details / payment reference"
        )

        return ENTER_PAYMENT

    else:

        await update.message.reply_text(
            f"💵 Sell USDT\n\n"
            f"USDT Amount: {amount} USDT\n"
            f"Rate: ₹{RATE}\n"
            f"Total INR: {format_money(inr_amount)}\n\n"
            "Now enter the USDT wallet address from which the USDT will be sent."
        )

        return ENTER_WALLET


